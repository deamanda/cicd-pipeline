pipeline {
    agent any
    tools {
        nodejs 'node'
    }
    stages {
        stage('Build') { 
            steps {
                sh 'npm install' 
            }
        }
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
        stage('Docker build') {
            steps {
                script {
                    dockerImage = docker.build("${DOCKER_USERNAME}/node${env.BRANCH_NAME}:v1.0")

                }
            }
        }
        stage('Scan Docker image for vulnerabilities') {
            steps {
                script {
                    def vulnerabilities=sh (script: "trivy image --exit-code 0 --severity HIGH,MEDIUM,LOW --no-progress ${DOCKER_USERNAME}/node${env.BRANCH_NAME}:v1.0", 
                    returnStdout: true).trim()
                    echo "Vulnerabilitity Report: \n${vulnerabilities}"
                }
            }
        }
        stage('Docker linter') {
            steps {
                script {
                    def vulnerabilities=sh (script: "hadolint dockerImage", 
                    returnStdout: true).trim()
                    echo "Vulnerabilitity Report: \n${vulnerabilities}"
                }
            }
        }
        stage('Docker push '){
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        dockerImage.push() }
                }
            }
        }
        stage('Deploy_to_main') {
            when {branch 'main'}
            steps {
                script {
                    def name = "app_${env.BRANCH_NAME}"
                    def image = "${DOCKER_USERNAME}/node${env.BRANCH_NAME}:v1.0"
                    sh "docker pull ${image}"
                    sh "docker rm -f ${name} || true"
                    sh "docker run -d --name ${name} --expose 3000 -p 3000:3000 ${image}"
                }
            }
        }
        stage('Deploy_to_dev') {
            when {branch 'dev'}
            steps {
                script {
                    def name = "app_${env.BRANCH_NAME}"
                    def image = "${DOCKER_USERNAME}/node${env.BRANCH_NAME}:v1.0"
                    sh "docker pull ${image}"
                    sh "docker rm -f ${name} || true"
                    sh "docker run -d --name ${name} --expose 3001 -p 3001:3000 ${image}"
                }
            }
        }        
    }
}
