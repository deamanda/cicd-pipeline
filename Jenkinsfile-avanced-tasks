@Library('JenkinsTesLib') _
pipeline {
    agent any
    stages {
        stage('Build') { 
            agent {
                docker {
                    image 'node:7.8.0'
                }
            }
            steps {
                sh 'npm install' 
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'node:7.8.0'
                }
            }
            steps {
                sh 'npm test'
            }
        }
        stage('Docker linter') {
            steps {
                script {
                    def vulnerabilities=sh (script: "hadolint Dockerfile --no-fail", 
                    returnStdout: true).trim()
                    echo "Vulnerabilitity Report: \n${vulnerabilities}"
                }
            }
        }
        stage('Docker build') {
            steps {
                script {
                    dockerImage = docker.build("${DOCKER_USERNAME}/node${env.BRANCH_NAME}:v1.0")

                }
            }
        }
        stage('Scan Docker image for vulnerabilities') {
            steps {
                script {
                    def vulnerabilities=sh (script: "trivy image --exit-code 0 --severity HIGH,MEDIUM,LOW --no-progress node${env.BRANCH_NAME}:v1.0", 
                    returnStdout: true).trim()
                    echo "Vulnerabilitity Report: \n${vulnerabilities}"
                }
            }
        }
        stage('Docker push '){
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        dockerImage.push() }
                }
            }
        }
        stage('Deploy_to_main') {
            when {branch 'main'}
            steps {
                script {
                    deploy_to_branch("app_${env.BRANCH_NAME}", "${DOCKER_USERNAME}/node${env.BRANCH_NAME}:v1.0",3000)
                }
            }
        }
        stage('Deploy_to_dev') {
            when {branch 'dev'}
            steps {
                script {
                    deploy_to_branch("app_${env.BRANCH_NAME}", "${DOCKER_USERNAME}/node${env.BRANCH_NAME}:v1.0", 3001)
                }
            }
        }        
    }
}
